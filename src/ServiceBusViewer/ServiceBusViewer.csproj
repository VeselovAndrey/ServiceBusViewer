<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</RepositoryRoot>

		<Version>0.11.0</Version>
		<Product>ServiceBusViewer</Product>
		<Authors>Andrey Veselov</Authors>
		<Copyright>Copyright © 2025-2026 Andrey Veselov</Copyright>
		<Description>A web-based viewer for Azure Service Bus.</Description>

		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
	</ItemGroup>

	<Target Name="BuildFrontendAssetsForLocalDebug"
	        BeforeTargets="Build"
	        Condition="'$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true'">
		<Message Importance="high" Text="Running npm-based UI asset build for local Debug build." />
		<Exec Command="npm ci"
		      WorkingDirectory="$(RepositoryRoot)"
		      Condition="!Exists('$(RepositoryRoot)\node_modules')" />
		<Exec Command="npm run build:assets"
		      WorkingDirectory="$(RepositoryRoot)" />
	</Target>

</Project>