@model ServiceBusViewer.Pages.Shared.EntityListModel
@using ServiceBusViewer.Infrastructure.ServiceBus.Models
@{
    var queues = Model.AvailableEntities.OfType<QueueEntityId>().OrderBy(entity => entity.Name).ToList();
    var topics = Model.AvailableEntities.OfType<TopicEntityId>().OrderBy(entity => entity.Name).ToList();
}

<aside class="flex w-full shrink-0 flex-col border-b border-slate-200 bg-slate-50 dark:border-zinc-800 dark:bg-zinc-950 lg:w-64 lg:border-b-0 lg:border-r">
    <div class="relative flex h-16 items-center px-3">
        <span class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Entities</span>
        <div class="pointer-events-none absolute right-3 bottom-0 left-3 h-px bg-slate-200 dark:bg-zinc-800"></div>
    </div>

    <nav class="custom-scrollbar flex-1 space-y-1 overflow-y-auto p-2">
        @if (queues.Count == 0 && topics.Count == 0) {
            <div class="rounded border border-dashed border-slate-300 bg-white/80 px-4 py-6 text-center text-sm text-slate-500 dark:border-zinc-700 dark:bg-zinc-900/60 dark:text-slate-400">
                No entities available
            </div>
        }
        else {
            @if (queues.Count > 0) {
                <section class="space-y-1">
                    <div class="px-2 py-1.5 text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Queues</div>
                    <div class="space-y-1">
                        @foreach (var queue in queues) {
                            var isActive = Model.EntityName == queue.Name && Model.TopicName is null;
                            <div class="flex items-stretch justify-between gap-1 text-sm">
                                <form method="post" asp-page="/Index" asp-page-handler="SelectEntity" class="min-w-0 flex-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="SelectedEntityName" value="@queue.Name" />
                                    <input type="hidden" name="SelectedEntityType" value="Queue" />
                                    <button type="submit" class="flex h-full w-full items-center gap-2 rounded px-2 py-1.5 text-left transition @(isActive ? "bg-brand-50 text-brand-600 dark:bg-brand-500/20 dark:text-brand-100 font-medium" : "text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:hover:bg-zinc-800")" data-entity-tooltip="@queue.Name">
                                        <span class="material-icons-round text-sm">view_headline</span>
                                        <span class="min-w-0 truncate">@queue.Name</span>
                                    </button>
                                </form>

                                @if (Model.DisplayPropertyLinks) {
                                    <a class="inline-flex h-6 w-6 shrink-0 items-center justify-center self-center rounded text-slate-400 transition hover:bg-slate-200 hover:text-slate-700 dark:hover:bg-zinc-700 dark:hover:text-slate-100" asp-page="/EntityInfo" asp-route-type="Queue" asp-route-name="@queue.Name" title="View queue properties" aria-label="View queue properties">
                                        <span class="material-icons-round text-[18px]">info</span>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </section>
            }

            @if (topics.Count > 0) {
                <section class="pt-2">
                    <div class="px-2 py-1.5 text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Topics</div>
                    <div class="space-y-1">
                        @foreach (var topic in topics) {
                            var isActiveTopic = Model.EntityName == topic.Name && Model.TopicName is null;
                            <div class="rounded">
                                <div class="flex items-stretch justify-between gap-1 text-sm">
                                    <div class="flex min-w-0 flex-1 items-center gap-2 rounded px-2 py-1.5 @(isActiveTopic ? "bg-brand-50 text-brand-600 dark:bg-brand-500/20 dark:text-brand-100 font-medium" : "text-slate-600 dark:text-slate-300")" data-entity-tooltip="@topic.Name" tabindex="0">
                                        <span class="material-icons-round text-sm">share</span>
                                        <span class="min-w-0 truncate">@topic.Name</span>
                                    </div>

                                    @if (Model.DisplayPropertyLinks) {
                                        <a class="inline-flex h-6 w-6 shrink-0 items-center justify-center self-center rounded text-slate-400 transition hover:bg-slate-200 hover:text-slate-700 dark:hover:bg-zinc-700 dark:hover:text-slate-100" asp-page="/EntityInfo" asp-route-type="Topic" asp-route-name="@topic.Name" title="View topic properties" aria-label="View topic properties">
                                            <span class="material-icons-round text-[18px]">info</span>
                                        </a>
                                    }
                                </div>

                                <div class="ml-4 mt-0.5 space-y-0.5 border-l-2 border-slate-200 pl-3 dark:border-zinc-800">
                                    @foreach (var subscription in Model.AvailableEntities.OfType<SubscriptionEntityId>().Where(entity => entity.TopicName == topic.Name).OrderBy(entity => entity.Name)) {
                                        var isActiveSubscription = Model.EntityName == subscription.Name && Model.TopicName == topic.Name;
                                        <div class="flex items-stretch justify-between gap-1 text-sm">
                                            <form method="post" asp-page="/Index" asp-page-handler="SelectEntity" class="min-w-0 flex-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="SelectedEntityName" value="@subscription.Name" />
                                                <input type="hidden" name="SelectedEntityType" value="Subscription" />
                                                <input type="hidden" name="SelectedTopicName" value="@subscription.TopicName" />
                                                <button type="submit" class="flex h-full w-full items-center gap-2 rounded px-2 py-1.5 text-left transition @(isActiveSubscription ? "bg-brand-50 text-brand-600 dark:bg-brand-500/20 dark:text-brand-100 font-medium" : "text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:hover:bg-zinc-800")" data-entity-tooltip="@subscription.Name">
                                                    <span class="material-icons-round text-sm">subtitles</span>
                                                    <span class="min-w-0 truncate">@subscription.Name</span>
                                                </button>
                                            </form>

                                            @if (Model.DisplayPropertyLinks) {
                                                <a class="inline-flex h-6 w-6 shrink-0 items-center justify-center self-center rounded text-slate-400 transition hover:bg-slate-200 hover:text-slate-700 dark:hover:bg-zinc-700 dark:hover:text-slate-100" asp-page="/EntityInfo" asp-route-type="Subscription" asp-route-name="@subscription.Name" asp-route-topicname="@subscription.TopicName" title="View subscription properties" aria-label="View subscription properties">
                                                    <span class="material-icons-round text-[18px]">info</span>
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        }
    </nav>
</aside>
