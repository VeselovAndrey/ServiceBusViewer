@page
@using ServiceBusViewer.Pages.Shared
@model ServiceBusViewer.Pages.ConnectModel
@{
    ViewData["Title"] = "Connect";
    ViewData["HeaderBarModel"] = new HeaderBarModel(
        new HeaderBarStatusModel("bg-amber-500", "Ready for a connection"));
    ViewData["FooterBarModel"] = new FooterBarModel("Ready to connect");
}

<div class="flex flex-1 flex-col bg-slate-100 text-slate-800 dark:bg-slate-950 dark:text-slate-100">
    <main class="flex flex-1 items-center px-4 pt-0 pb-4 lg:px-8 lg:pt-0 lg:pb-4">
        <div class="mx-auto flex w-full max-w-[2124px] items-stretch gap-6">
            <section class="hidden w-[350px] shrink-0 flex-col justify-center rounded-3xl border border-slate-200 bg-white/85 p-6 shadow-xl shadow-slate-200/40 backdrop-blur dark:border-slate-800 dark:bg-slate-900/85 dark:shadow-black/20 min-[760px]:flex min-[1151px]:w-[700px] lg:p-8">
                <div class="mt-5 flex justify-center">
                    <img src="/images/app-logo-680x680.png" alt="Service Bus Viewer logo" class="h-auto w-auto max-w-[18rem] object-contain" />
                </div>

                <div class="mt-8 grid gap-4 sm:grid-cols-2">
                    <div class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50/80 p-4 dark:border-slate-800 dark:bg-slate-950/60">
                        <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700 dark:bg-emerald-950/70 dark:text-emerald-300">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 7.75A2.75 2.75 0 0 1 6.75 5h10.5A2.75 2.75 0 0 1 20 7.75v8.5A2.75 2.75 0 0 1 17.25 19H6.75A2.75 2.75 0 0 1 4 16.25Z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 9.5h8M8 13h5" />
                                </svg>
                            </span>
                        <div>
                            <div class="text-sm font-semibold text-slate-900 dark:text-white">Namespace browsing</div>
                            <div class="text-xs text-slate-500 dark:text-slate-400">Use a root connection string to browse every queue, topic, and subscription.</div>
                        </div>
                    </div>

                    <div class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50/80 p-4 dark:border-slate-800 dark:bg-slate-950/60">
                        <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-violet-100 text-violet-700 dark:bg-violet-950/70 dark:text-violet-300">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 19.25h12M7.75 16.5h8.5A1.75 1.75 0 0 0 18 14.75v-8.5A1.75 1.75 0 0 0 16.25 4.5h-8.5A1.75 1.75 0 0 0 6 6.25v8.5A1.75 1.75 0 0 0 7.75 16.5Z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 8.5h6m-6 3h6" />
                                </svg>
                            </span>
                        <div>
                            <div class="text-sm font-semibold text-slate-900 dark:text-white">Message operations</div>
                            <div class="text-xs text-slate-500 dark:text-slate-400">Peek, receive, inspect, and send messages with system and app properties.</div>
                        </div>
                    </div>

                    <div class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50/80 p-4 dark:border-slate-800 dark:bg-slate-950/60">
                        <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-700 dark:bg-amber-950/70 dark:text-amber-300">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3.5 20 7v10l-8 3.5L4 17V7l8-3.5Z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 7l8 3.5L20 7M12 10.5V20.5" />
                                </svg>
                            </span>
                        <div>
                            <div class="text-sm font-semibold text-slate-900 dark:text-white">Emulator-friendly</div>
                            <div class="text-xs text-slate-500 dark:text-slate-400">Works well with localhost or container-based development endpoints.</div>
                        </div>
                    </div>

                    <div class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50/80 p-4 dark:border-slate-800 dark:bg-slate-950/60">
                        <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-100 text-brand-700 dark:bg-brand-900/60 dark:text-brand-300">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 7.75A2.75 2.75 0 0 1 8.75 5h6.5A2.75 2.75 0 0 1 18 7.75v8.5A2.75 2.75 0 0 1 15.25 19h-6.5A2.75 2.75 0 0 1 6 16.25Z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.5h6M9 13h6" />
                                </svg>
                            </span>
                        <div>
                            <div class="text-sm font-semibold text-slate-900 dark:text-white">Connection modes</div>
                            <div class="text-xs text-slate-500 dark:text-slate-400">Use a root connection string to browse the full namespace, or only a connection string plus entity name for direct queue or topic access.</div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="min-w-0 max-w-[1400px] flex-1 rounded-3xl border border-slate-200 bg-white/90 p-6 shadow-xl shadow-slate-200/40 backdrop-blur dark:border-slate-800 dark:bg-slate-900/90 dark:shadow-black/20 lg:p-8">
                <div class="flex items-center justify-between gap-4 border-b border-slate-200 pb-4 dark:border-slate-800">
                    <div>
                        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Connect to Service Bus</h2>
                        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Choose namespace-wide browsing or connect directly to a specific entity.</p>
                    </div>
                </div>

                @if (!ViewData.ModelState.IsValid) {
                    <div class="mt-5 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900/70 dark:bg-rose-950/40 dark:text-rose-200">
                        <div class="flex items-start gap-3">
                            <svg class="mt-0.5 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v5m0 3h.01" />
                            </svg>
                            <div class="space-y-1">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors)) {
                                    <div>@error.ErrorMessage</div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <form method="post" asp-page-handler="Connect" class="mt-6 space-y-5">
                    @Html.AntiForgeryToken()

                    <div>
                        <label asp-for="ConnectionString" class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Connection String</label>
                        <input asp-for="ConnectionString" class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-800 shadow-sm shadow-slate-200/50 transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:shadow-black/20 dark:focus:border-brand-400" placeholder="Endpoint=sb://localhost;SharedAccessKeyName=..." />
                    </div>

                    <div>
                        <label asp-for="RootConnectionString" class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Root Connection String</label>
                        <input asp-for="RootConnectionString" class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-800 shadow-sm shadow-slate-200/50 transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:shadow-black/20 dark:focus:border-brand-400" placeholder="Optional, enables namespace browsing" />
                        <p class="mt-2 text-xs leading-5 text-slate-500 dark:text-slate-400">
                            Leave this blank to connect directly to a single queue or topic.
                        </p>
                    </div>

                    <div class="grid gap-5 sm:grid-cols-2">
                        <div>
                            <label asp-for="QueueOrTopicName" class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Queue or Topic</label>
                            <input asp-for="QueueOrTopicName" class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-800 shadow-sm shadow-slate-200/50 transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:shadow-black/20 dark:focus:border-brand-400" placeholder="Required without root access" />
                        </div>

                        <div>
                            <label asp-for="SubscriptionName" class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Subscription</label>
                            <input asp-for="SubscriptionName" class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-800 shadow-sm shadow-slate-200/50 transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:shadow-black/20 dark:focus:border-brand-400" placeholder="Optional for topic subscriptions" />
                        </div>
                    </div>

                    <div class="rounded-2xl border border-slate-200 bg-slate-50/80 px-4 py-3 text-xs leading-5 text-slate-500 dark:border-slate-800 dark:bg-slate-950/60 dark:text-slate-400">
                        For Docker or Podman, use <span class="font-mono text-slate-700 dark:text-slate-200">host.docker.internal</span> instead of
                        <span class="font-mono text-slate-700 dark:text-slate-200">localhost</span> when targeting the emulator on the host machine.
                    </div>

                    <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-950/20 transition hover:bg-brand-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-offset-slate-900">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
                        </svg>
                        Connect
                    </button>
                </form>
            </section>
        </div>
    </main>
</div>
