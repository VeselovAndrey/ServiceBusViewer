@page

@using ServiceBusViewer.Infrastructure.ServiceBus.Models
@using ServiceBusViewer.Pages.Shared

@model ServiceBusViewer.Pages.EntityInfoModel
@{
    ViewData["Title"] = "Entity Details";
    ViewData["HeaderBarModel"] = new HeaderBarModel(
        new HeaderBarStatusModel("bg-emerald-500", "Connected to", Model.ServiceBusHostName),
        new HeaderBarActionModel(
            HeaderBarActionKind.Link,
            "Viewer",
            "chevron_left",
            Page: "/Index"));
    ViewData["FooterBarModel"] = new FooterBarModel("Entity properties view");
}

<div class="flex flex-1 flex-col bg-slate-100 text-slate-800 dark:bg-slate-950 dark:text-slate-100">
    <div class="flex flex-1 flex-col overflow-hidden lg:flex-row">
        @await Html.PartialAsync("_EntityList", new EntityListModel(Model.AvailableEntities, Model.Name, Model.TopicName, Model.IsManagementApiAvailable))

        <main class="flex min-w-0 flex-1 flex-col overflow-hidden">
            <div class="flex flex-col gap-4 border-b border-slate-200 bg-white/80 px-4 py-4 dark:border-slate-800 dark:bg-slate-950/60 lg:flex-row lg:items-center lg:justify-between lg:px-6">
                <div class="min-w-0">
                    <div class="flex items-center gap-3">
                        <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand-100 text-brand-700 dark:bg-brand-900/60 dark:text-brand-300">
                            @if (string.Equals(Model.Type, "Subscription", StringComparison.OrdinalIgnoreCase)) {
                                <span class="material-icons-round text-[20px]">subtitles</span>
                            }
                            else if (string.Equals(Model.Type, "Topic", StringComparison.OrdinalIgnoreCase)) {
                                <span class="material-icons-round text-[20px]">share</span>
                            }
                            else {
                                <span class="material-icons-round text-[20px]">view_headline</span>
                            }
                        </span>

                        <div class="min-w-0">
                            <h1 class="truncate text-lg font-semibold text-slate-900 dark:text-white">@Model.Name</h1>
                            <p class="text-sm text-slate-500 dark:text-slate-400">
                                @Model.Type entity
                                @if (!string.IsNullOrWhiteSpace(Model.TopicName)) {
                                    <span> for topic <span class="font-mono text-slate-700 dark:text-slate-200">@Model.TopicName</span></span>
                                }
                            </p>
                        </div>
                    </div>
                </div>

                <div class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs text-slate-500 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400">
                    Cached properties view
                </div>
            </div>

            <div class="custom-scrollbar flex-1 overflow-y-auto p-4 lg:p-6">
                @if (Model.ErrorMessage is not null) {
                    <div class="mb-6 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900/70 dark:bg-rose-950/40 dark:text-rose-200">
                        <div class="flex items-start gap-3">
                            <svg class="mt-0.5 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v5m0 3h.01" />
                            </svg>
                            <div>@Model.ErrorMessage</div>
                        </div>
                    </div>
                }

                <section class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm shadow-slate-200/40 dark:border-slate-800 dark:bg-slate-900 dark:shadow-black/20">
                    <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-800">
                        <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Entity properties</h2>
                        <span class="rounded-full bg-slate-100 px-2 py-1 text-[11px] text-slate-500 dark:bg-slate-800 dark:text-slate-400">Read-only</span>
                    </div>

                    <div class="p-4 lg:p-6">
                        @if (Model.Properties is not null) {
                            <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800">
                                <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-800">
                                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                        @switch (Model.Properties) {
                                            case QueueEntityProperties queue:
                                                <tr class="bg-slate-50/70 dark:bg-slate-950/40"><th class="w-1/3 px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Name</th><td class="px-4 py-3 font-mono text-slate-700 dark:text-slate-200">@queue.Name</td></tr>
                                                <tr><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Type</th><td class="px-4 py-3">Queue</td></tr>
                                                <tr class="bg-slate-50/70 dark:bg-slate-950/40"><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Lock Duration</th><td class="px-4 py-3 font-mono">@queue.LockDuration</td></tr>
                                                <tr><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Requires Session</th><td class="px-4 py-3">@queue.RequiresSession</td></tr>
                                                <tr class="bg-slate-50/70 dark:bg-slate-950/40"><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Enable Partitioning</th><td class="px-4 py-3">@queue.EnablePartitioning</td></tr>
                                                <tr><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Enable Batched Operations</th><td class="px-4 py-3">@queue.EnableBatchedOperations</td></tr>
                                                <tr class="bg-slate-50/70 dark:bg-slate-950/40"><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Max Delivery Count</th><td class="px-4 py-3">@queue.MaxDeliveryCount</td></tr>
                                                <tr><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Default TTL</th><td class="px-4 py-3 font-mono">@queue.DefaultMessageTimeToLive</td></tr>
                                                <tr class="bg-slate-50/70 dark:bg-slate-950/40"><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Requires Duplicate Detection</th><td class="px-4 py-3">@queue.RequiresDuplicateDetection</td></tr>
                                                <tr><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Duplicate Detection Window</th><td class="px-4 py-3 font-mono">@queue.DuplicateDetectionHistoryTimeWindow</td></tr>
                                                <tr class="bg-slate-50/70 dark:bg-slate-950/40"><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Dead-letter on Expiration</th><td class="px-4 py-3">@queue.DeadLetteringOnMessageExpiration</td></tr>
                                                <tr><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Auto Delete on Idle</th><td class="px-4 py-3 font-mono">@queue.AutoDeleteOnIdle</td></tr>
                                                break;

                                            case TopicEntityProperties topic:
                                                <tr class="bg-slate-50/70 dark:bg-slate-950/40"><th class="w-1/3 px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Name</th><td class="px-4 py-3 font-mono text-slate-700 dark:text-slate-200">@topic.Name</td></tr>
                                                <tr><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Type</th><td class="px-4 py-3">Topic</td></tr>
                                                <tr class="bg-slate-50/70 dark:bg-slate-950/40"><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Enable Partitioning</th><td class="px-4 py-3">@topic.EnablePartitioning</td></tr>
                                                <tr><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Enable Batched Operations</th><td class="px-4 py-3">@topic.EnableBatchedOperations</td></tr>
                                                <tr class="bg-slate-50/70 dark:bg-slate-950/40"><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Default TTL</th><td class="px-4 py-3 font-mono">@topic.DefaultMessageTimeToLive</td></tr>
                                                <tr><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Requires Duplicate Detection</th><td class="px-4 py-3">@topic.RequiresDuplicateDetection</td></tr>
                                                <tr class="bg-slate-50/70 dark:bg-slate-950/40"><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Duplicate Detection Window</th><td class="px-4 py-3 font-mono">@topic.DuplicateDetectionHistoryTimeWindow</td></tr>
                                                <tr><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Auto Delete on Idle</th><td class="px-4 py-3 font-mono">@topic.AutoDeleteOnIdle</td></tr>
                                                break;

                                            case SubscriptionEntityProperties subscription:
                                                <tr class="bg-slate-50/70 dark:bg-slate-950/40"><th class="w-1/3 px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Name</th><td class="px-4 py-3 font-mono text-slate-700 dark:text-slate-200">@subscription.Name</td></tr>
                                                <tr><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Type</th><td class="px-4 py-3">Subscription</td></tr>
                                                <tr class="bg-slate-50/70 dark:bg-slate-950/40"><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Topic</th><td class="px-4 py-3 font-mono">@subscription.TopicName</td></tr>
                                                <tr><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Lock Duration</th><td class="px-4 py-3 font-mono">@subscription.LockDuration</td></tr>
                                                <tr class="bg-slate-50/70 dark:bg-slate-950/40"><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Requires Session</th><td class="px-4 py-3">@subscription.RequiresSession</td></tr>
                                                <tr><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Enable Batched Operations</th><td class="px-4 py-3">@subscription.EnableBatchedOperations</td></tr>
                                                <tr class="bg-slate-50/70 dark:bg-slate-950/40"><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Max Delivery Count</th><td class="px-4 py-3">@subscription.MaxDeliveryCount</td></tr>
                                                <tr><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Default TTL</th><td class="px-4 py-3 font-mono">@subscription.DefaultMessageTimeToLive</td></tr>
                                                <tr class="bg-slate-50/70 dark:bg-slate-950/40"><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Dead-letter on Expiration</th><td class="px-4 py-3">@subscription.DeadLetteringOnMessageExpiration</td></tr>
                                                <tr><th class="px-4 py-3 text-left font-medium text-slate-500 dark:text-slate-400">Auto Delete on Idle</th><td class="px-4 py-3 font-mono">@subscription.AutoDeleteOnIdle</td></tr>
                                                break;

                                            default:
                                                <tr>
                                                    <td colspan="2" class="px-4 py-4 text-rose-600 dark:text-rose-300">Unsupported entity type: @Model.Properties.GetType().FullName.</td>
                                                </tr>
                                                break;
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @if (Model.Properties is SubscriptionEntityProperties subscriptionWithRules && subscriptionWithRules.Rules.Count > 0) {
                                <div class="mt-6 space-y-3">
                                    <div class="flex items-center justify-between">
                                        <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Subscription rules</h3>
                                        <span class="rounded-full bg-slate-100 px-2 py-1 text-[11px] text-slate-500 dark:bg-slate-800 dark:text-slate-400">@subscriptionWithRules.Rules.Count total</span>
                                    </div>

                                    @foreach (var rule in subscriptionWithRules.Rules) {
                                        <article class="rounded-2xl border border-slate-200 bg-slate-50/80 p-4 dark:border-slate-800 dark:bg-slate-950/60">
                                            <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                                                <div>
                                                    <h4 class="text-sm font-semibold text-slate-900 dark:text-white">@rule.Name</h4>
                                                    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                                                        @switch (rule) {
                                                            case SqlSubscriptionFilterRule:
                                                                @:SQL filter
                                                                break;
                                                            case CorrelationSubscriptionFilterRule:
                                                                @:Correlation filter
                                                                break;
                                                            case UnknownSubscriptionFilterRule unknownRule:
                                                                @unknownRule.FilterTypeName
                                                                break;
                                                            default:
                                                                @:Unsupported rule
                                                                break;
                                                        }
                                                    </p>
                                                </div>
                                            </div>

                                            <div class="mt-4 space-y-3 text-sm">
                                                @switch (rule) {
                                                    case SqlSubscriptionFilterRule sqlRule:
                                                        <div>
                                                            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Expression</div>
                                                            <pre class="mt-2 overflow-x-auto rounded-2xl border border-slate-200 bg-white p-3 font-mono text-xs text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200">@sqlRule.SqlExpression</pre>
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(sqlRule.ActionExpression)) {
                                                            <div>
                                                                <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Action</div>
                                                                <pre class="mt-2 overflow-x-auto rounded-2xl border border-slate-200 bg-white p-3 font-mono text-xs text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200">@sqlRule.ActionExpression</pre>
                                                            </div>
                                                        }
                                                        break;

                                                    case CorrelationSubscriptionFilterRule correlationRule:
                                                        <div class="grid gap-3 sm:grid-cols-2">
                                                            @if (!string.IsNullOrEmpty(correlationRule.CorrelationId)) {
                                                                <div class="rounded-2xl border border-slate-200 bg-white px-3 py-3 dark:border-slate-800 dark:bg-slate-900">
                                                                    <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Correlation ID</div>
                                                                    <div class="mt-1 font-mono text-xs text-slate-700 dark:text-slate-200">@correlationRule.CorrelationId</div>
                                                                </div>
                                                            }
                                                            @if (!string.IsNullOrEmpty(correlationRule.MessageId)) {
                                                                <div class="rounded-2xl border border-slate-200 bg-white px-3 py-3 dark:border-slate-800 dark:bg-slate-900">
                                                                    <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Message ID</div>
                                                                    <div class="mt-1 font-mono text-xs text-slate-700 dark:text-slate-200">@correlationRule.MessageId</div>
                                                                </div>
                                                            }
                                                            @if (!string.IsNullOrEmpty(correlationRule.To)) {
                                                                <div class="rounded-2xl border border-slate-200 bg-white px-3 py-3 dark:border-slate-800 dark:bg-slate-900">
                                                                    <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">To</div>
                                                                    <div class="mt-1 text-xs text-slate-700 dark:text-slate-200">@correlationRule.To</div>
                                                                </div>
                                                            }
                                                            @if (!string.IsNullOrEmpty(correlationRule.ReplyTo)) {
                                                                <div class="rounded-2xl border border-slate-200 bg-white px-3 py-3 dark:border-slate-800 dark:bg-slate-900">
                                                                    <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Reply To</div>
                                                                    <div class="mt-1 text-xs text-slate-700 dark:text-slate-200">@correlationRule.ReplyTo</div>
                                                                </div>
                                                            }
                                                            @if (!string.IsNullOrEmpty(correlationRule.Subject)) {
                                                                <div class="rounded-2xl border border-slate-200 bg-white px-3 py-3 dark:border-slate-800 dark:bg-slate-900">
                                                                    <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Subject</div>
                                                                    <div class="mt-1 text-xs text-slate-700 dark:text-slate-200">@correlationRule.Subject</div>
                                                                </div>
                                                            }
                                                            @if (!string.IsNullOrEmpty(correlationRule.SessionId)) {
                                                                <div class="rounded-2xl border border-slate-200 bg-white px-3 py-3 dark:border-slate-800 dark:bg-slate-900">
                                                                    <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Session ID</div>
                                                                    <div class="mt-1 font-mono text-xs text-slate-700 dark:text-slate-200">@correlationRule.SessionId</div>
                                                                </div>
                                                            }
                                                            @if (!string.IsNullOrEmpty(correlationRule.ReplyToSessionId)) {
                                                                <div class="rounded-2xl border border-slate-200 bg-white px-3 py-3 dark:border-slate-800 dark:bg-slate-900">
                                                                    <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Reply To Session ID</div>
                                                                    <div class="mt-1 font-mono text-xs text-slate-700 dark:text-slate-200">@correlationRule.ReplyToSessionId</div>
                                                                </div>
                                                            }
                                                            @if (!string.IsNullOrEmpty(correlationRule.ContentType)) {
                                                                <div class="rounded-2xl border border-slate-200 bg-white px-3 py-3 dark:border-slate-800 dark:bg-slate-900">
                                                                    <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Content Type</div>
                                                                    <div class="mt-1 text-xs text-slate-700 dark:text-slate-200">@correlationRule.ContentType</div>
                                                                </div>
                                                            }
                                                        </div>

                                                        @if (correlationRule.ApplicationProperties.Count > 0) {
                                                            <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800">
                                                                <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-800">
                                                                    <thead class="bg-slate-50 text-slate-500 dark:bg-slate-950/50 dark:text-slate-400">
                                                                        <tr>
                                                                            <th class="px-4 py-2 text-left font-medium">Application Property</th>
                                                                            <th class="px-4 py-2 text-left font-medium">Value</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                                                        @foreach (var property in correlationRule.ApplicationProperties) {
                                                                            <tr>
                                                                                <td class="px-4 py-2 font-mono text-xs text-slate-700 dark:text-slate-200">@property.Key</td>
                                                                                <td class="px-4 py-2 text-xs text-slate-600 dark:text-slate-300">@property.Value</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        }

                                                        @if (!string.IsNullOrEmpty(correlationRule.ActionExpression)) {
                                                            <div>
                                                                <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Action</div>
                                                                <pre class="mt-2 overflow-x-auto rounded-2xl border border-slate-200 bg-white p-3 font-mono text-xs text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200">@correlationRule.ActionExpression</pre>
                                                            </div>
                                                        }
                                                        break;

                                                    case UnknownSubscriptionFilterRule unknownRule:
                                                        <div class="grid gap-3">
                                                            <div class="rounded-2xl border border-slate-200 bg-white px-3 py-3 dark:border-slate-800 dark:bg-slate-900">
                                                                <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Filter Type</div>
                                                                <div class="mt-1 text-xs text-slate-700 dark:text-slate-200">@unknownRule.FilterTypeName</div>
                                                            </div>
                                                            <div>
                                                                <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Details</div>
                                                                <pre class="mt-2 overflow-x-auto rounded-2xl border border-slate-200 bg-white p-3 font-mono text-xs text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200">@unknownRule.FilterExpression</pre>
                                                            </div>
                                                        </div>
                                                        break;

                                                    default:
                                                        <div class="text-sm text-slate-500 dark:text-slate-400">Unsupported rule type.</div>
                                                        break;
                                                }
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                        }
                        else {
                            <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-950/50 dark:text-slate-400">
                                Property list is empty.
                            </div>
                        }
                    </div>
                </section>
            </div>
        </main>
    </div>

</div>
