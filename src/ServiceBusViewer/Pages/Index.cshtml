@page
@using ServiceBusViewer.Infrastructure.ServiceBus.Models
@using ServiceBusViewer.Pages.Shared
@model ServiceBusViewer.Pages.IndexModel
@{
    var hasSelectedEntity = !string.IsNullOrWhiteSpace(Model.EntityName);
    var isSubscription = !string.IsNullOrWhiteSpace(Model.TopicName);
    var isTopic = !isSubscription && hasSelectedEntity && Model.AvailableEntities.OfType<TopicEntityId>().Any(entity => entity.Name == Model.EntityName);
    var entityTypeLabel = isSubscription ? "Subscription" : isTopic ? "Topic" : "Queue";
    var entitySubtitle = !hasSelectedEntity
        ? "Select a queue or subscription from the left sidebar to load messages."
        : isSubscription
            ? $"Streaming from topic {Model.TopicName}"
            : isTopic
                ? "Topic publishing surface"
                : "Queue messages and operations";
    var peekedMessageSummary = Model.HasMoreMessages ? $"Showing first {Model.Messages.Count}" : $"{Model.Messages.Count} total";
    var commonContentTypes = new[] {
        "application/json",
        "text/plain",
        "text/html",
        "application/xml",
        "text/xml",
        "application/x-www-form-urlencoded",
        "text/csv"
    };

    ViewData["Title"] = hasSelectedEntity ? Model.EntityName : "Viewer";
    ViewData["HeaderBarModel"] = new HeaderBarModel(
        new HeaderBarStatusModel("bg-emerald-500", "Connected to", Model.ServiceBusHostName),
        new HeaderBarActionModel(
            HeaderBarActionKind.Post,
            "Disconnect",
            "logout",
            PageHandler: "Disconnect",
            FormId: "disconnectForm",
            SubmitButtonId: "disconnectSubmitBtn"));
    ViewData["FooterBarModel"] = new FooterBarModel(Model.RequiresSession ? "Session-aware receive enabled" : "Standard receive mode");
}

<div class="flex flex-1 flex-col bg-slate-100 text-slate-800 dark:bg-slate-950 dark:text-slate-100">
    <div class="flex flex-1 flex-col overflow-hidden lg:flex-row">
        @await Html.PartialAsync("_EntityList", new EntityListModel(Model.AvailableEntities, Model.EntityName, Model.TopicName, Model.IsManagementApiAvailable))

        <main class="flex min-w-0 flex-1 flex-col overflow-hidden">
            <div class="flex flex-col gap-4 border-b border-slate-200 bg-white px-4 py-3 dark:border-zinc-800 dark:bg-zinc-900 lg:flex-row lg:items-center lg:justify-between lg:px-4">
                <div class="min-w-0">
                    <div class="flex items-center gap-3">
                        <span class="material-icons-round text-brand-500">@(isSubscription ? "subtitles" : isTopic ? "share" : "view_headline")</span>

                        <div class="min-w-0">
                            <h1 class="truncate text-sm font-semibold text-slate-900 dark:text-white">@(hasSelectedEntity ? Model.EntityName : "No entity selected")</h1>
                            <p class="text-sm text-slate-500 dark:text-slate-400">
                                @entityTypeLabel
                                @if (hasSelectedEntity) {
                                    <span> - @entitySubtitle</span>
                                }
                                else {
                                    <span> - @entitySubtitle</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-5">
                    <form method="post" asp-page-handler="Refresh" id="refreshForm">
                        @Html.AntiForgeryToken()
                        <button type="submit" id="refreshSubmitBtn" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs shadow-sm transition hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:bg-zinc-800">
                            <span class="material-icons-round text-sm">refresh</span>
                            Refresh
                        </button>
                    </form>

                    <form method="post" asp-page-handler="Receive" id="receiveForm" class="flex flex-wrap items-center">
                        @Html.AntiForgeryToken()
                        <div class="inline-flex items-stretch overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
                            <input type="text" id="receiveSessionIdInput" name="ReceiveSessionId" value="@Model.ReceiveSessionId" placeholder="Session ID" class="w-44 border-0 bg-transparent px-3 py-1.5 text-xs text-slate-700 transition placeholder:text-slate-400 focus:ring-0 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-400 dark:text-slate-100 dark:placeholder:text-slate-500 dark:disabled:bg-zinc-950" @(!Model.RequiresSession ? "disabled='disabled'" : null) />
                            <button type="submit" id="receiveSubmitBtn" class="inline-flex items-center gap-1.5 border-l border-slate-200 px-3 py-1.5 text-xs transition hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 dark:border-zinc-800 dark:hover:bg-zinc-800">
                                <span class="material-icons-round text-sm">download</span>
                                Receive
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="custom-scrollbar flex-1 overflow-y-auto p-4 lg:p-6">
                @if (!ViewData.ModelState.IsValid) {
                    <div class="mb-6 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-900/70 dark:bg-rose-950/40 dark:text-rose-200">
                        <div class="flex items-start gap-3">
                            <svg class="mt-0.5 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v5m0 3h.01" />
                            </svg>
                            <div class="space-y-1">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors)) {
                                    <div>@error.ErrorMessage</div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.SendResultMessage)) {
                    <div class="mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700 dark:border-emerald-900/70 dark:bg-emerald-950/40 dark:text-emerald-200">
                        <div class="flex items-start gap-3">
                            <svg class="mt-0.5 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 12.5 10.5 15.5 16.5 8.5" />
                                <circle cx="12" cy="12" r="9" />
                            </svg>
                            <div>@Model.SendResultMessage</div>
                        </div>
                    </div>
                }

                <section class="mb-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm shadow-slate-200/40 dark:border-slate-800 dark:bg-slate-900 dark:shadow-black/20">
                    <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-800">
                            <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Send Message</h2>
                            <button type="button" id="toggleSendFormBtn" class="inline-flex w-20 items-center justify-center gap-1 rounded-lg bg-slate-100 px-2 py-1 text-[11px] font-medium text-slate-500 transition hover:bg-slate-200 hover:text-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-white">
                                <span id="toggleSendFormBtnIcon" class="material-icons-round text-sm">keyboard_arrow_up</span>
                                <span id="toggleSendFormBtnText" class="text-center">Hide</span>
                            </button>
                        </div>

                    <div id="sendFormWrapper" class="send-form-transition">
                        <form method="post" asp-page-handler="Send" id="sendMessageForm" class="p-4 lg:p-6">
                            @Html.AntiForgeryToken()

                            <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_19rem]">
                                <div>
                                    <label class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Payload</label>
                                    <textarea name="SendMessageBody" rows="12" class="block min-h-56 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-mono text-sm text-slate-700 shadow-sm shadow-slate-200/40 transition placeholder:text-slate-400 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:shadow-black/20 dark:placeholder:text-slate-500 dark:focus:border-brand-400">@Model.SendMessageBody</textarea>
                                </div>

                                <div class="space-y-4">
                                    <div>
                                        <label class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Message ID</label>
                                        <input type="text" name="SendMessageProperties.MessageId" value="@Model.SendMessageProperties.MessageId" maxlength="128" class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm shadow-slate-200/40 transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:shadow-black/20 dark:focus:border-brand-400" />
                                    </div>

                                    <div>
                                        <label class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Session ID</label>
                                        <input type="text" name="SendMessageProperties.SessionId" value="@Model.SendMessageProperties.SessionId" maxlength="128" class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm shadow-slate-200/40 transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:shadow-black/20 dark:focus:border-brand-400" placeholder="Optional" />
                                    </div>

                                    <div>
                                        <label class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Correlation ID</label>
                                        <input type="text" name="SendMessageProperties.CorrelationId" value="@Model.SendMessageProperties.CorrelationId" maxlength="128" class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm shadow-slate-200/40 transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:shadow-black/20 dark:focus:border-brand-400" />
                                    </div>

                                    <div>
                                        <label class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Content Type</label>
                                        <div class="relative">
                                            <div class="flex items-stretch overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm shadow-slate-200/40 transition focus-within:border-brand-500 focus-within:ring-2 focus-within:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-950 dark:shadow-black/20 dark:focus-within:border-brand-400">
                                                <input type="text" id="contentTypeInput" name="SendMessageProperties.ContentType" value="@Model.SendMessageProperties.ContentType" autocomplete="off" class="min-w-0 flex-1 border-0 bg-transparent px-3 py-2 text-sm text-slate-700 focus:ring-0 dark:text-slate-100" />
                                            <button type="button" id="contentTypePickerToggle" class="inline-flex w-11 items-center justify-center border-l border-slate-200 bg-slate-50 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-none dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white" aria-expanded="false" aria-controls="contentTypePickerMenu" aria-label="Toggle common content types" title="Toggle common content types">
                                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
                                                </svg>
                                            </button>
                                        </div>

                                        <div id="contentTypePickerMenu" class="absolute left-0 right-0 top-full z-20 mt-2 hidden overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-200/60 dark:border-slate-800 dark:bg-slate-900 dark:shadow-black/30">
                                                <div class="border-b border-slate-200 px-3 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500 dark:border-slate-800 dark:text-slate-400">
                                                    Common content types
                                                </div>
                                                <div class="custom-scrollbar h-48 overflow-y-scroll p-2 pr-2" style="scrollbar-gutter: stable;">
                                                    <div class="grid gap-1.5">
                                                        @foreach (var contentType in commonContentTypes) {
                                                            <button type="button" data-content-type-option="@contentType" class="flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium text-slate-700 transition hover:bg-brand-50 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 dark:text-slate-200 dark:hover:bg-brand-950/30 dark:hover:text-brand-300">
                                                                <span>@contentType</span>
                                                            </button>
                                                        }
                                                    </div>
                                                    <div id="contentTypePickerEmpty" class="hidden px-3 py-4 text-sm text-slate-500 dark:text-slate-400">
                                                        No matching content types.
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-6 grid gap-4 lg:grid-cols-2">
                                <div>
                                    <label class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Scheduled Enqueue Time</label>
                                    <input type="datetime-local" name="SendMessageProperties.ScheduledEnqueueTime" value="@Model.SendMessageProperties.ScheduledEnqueueTime?.ToString("yyyy-MM-ddTHH:mm")" class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm shadow-slate-200/40 transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:shadow-black/20 dark:focus:border-brand-400" />
                                </div>

                                <div>
                                    <label class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Time To Live</label>
                                    <input type="text" name="SendMessageProperties.TimeToLive" value="@Model.SendMessageProperties.TimeToLive" placeholder="hh:mm:ss" class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm shadow-slate-200/40 transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:shadow-black/20 dark:focus:border-brand-400" />
                                </div>
                            </div>

                            <div class="mt-6">
                                <div class="mb-3 flex items-center justify-between gap-3">
                                    <div>
                                        <label class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Application Properties</label>
                                        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Optional typed key-value metadata to attach to the outgoing message.</p>
                                    </div>
                                    <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-700 dark:hover:bg-slate-800" onclick="addProperty()">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
                                        </svg>
                                        Add Property
                                    </button>
                                </div>

                                <div id="properties-container" class="space-y-3">
                                    @for (int i = 0; i < Model.SendMessageApplicationProperties.Count; i++) {
                                        <div class="js-property-row grid gap-3 rounded-2xl border border-slate-200 bg-slate-50/80 p-3 dark:border-slate-800 dark:bg-slate-950/60 xl:grid-cols-[minmax(0,1fr)_11rem_minmax(0,1fr)_auto]">
                                            <input type="text" name="SendMessageApplicationProperties[@i].Key" value="@Model.SendMessageApplicationProperties[i].Key" placeholder="Key" data-property-field="key" class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm shadow-slate-200/40 transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100 dark:shadow-black/20 dark:focus:border-brand-400" />
                                            <select name="SendMessageApplicationProperties[@i].Type" data-property-field="type" class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm shadow-slate-200/40 transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100 dark:shadow-black/20 dark:focus:border-brand-400">
                                                @foreach (var type in Enum.GetValues<ApplicationPropertyType>()) {
                                                    <option value="@type" selected="@(type == Model.SendMessageApplicationProperties[i].Type)">@type</option>
                                                }
                                            </select>
                                            <input type="text" name="SendMessageApplicationProperties[@i].Value" value="@Model.SendMessageApplicationProperties[i].Value" data-property-field="value" class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm shadow-slate-200/40 transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100 dark:shadow-black/20 dark:focus:border-brand-400" placeholder="Value" />
                                            <button type="button" data-remove-property class="inline-flex items-center justify-center rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-medium text-rose-700 transition hover:bg-rose-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 dark:border-rose-900/70 dark:bg-rose-950/40 dark:text-rose-300 dark:hover:bg-rose-950/70">Remove</button>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="mt-6 flex justify-end">
                                <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-950/20 transition hover:bg-brand-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 disabled:cursor-not-allowed disabled:opacity-60" id="sendMessageSubmitBtn" @(!string.IsNullOrWhiteSpace(Model.EntityName) ? null : "disabled=\"disabled\"")>
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h11M12 5l7 7-7 7" />
                                    </svg>
                                    Send Message
                                </button>
                            </div>
                        </form>
                    </div>
                </section>

                <section class="mb-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm shadow-slate-200/40 dark:border-slate-800 dark:bg-slate-900 dark:shadow-black/20">
                    <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50/80 px-4 py-3 dark:border-slate-800 dark:bg-slate-950/40">
                        <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Active Message Details</h2>
                        @if (Model.DisplayedMessage is not null) {
                            <span class="rounded-xl bg-slate-200 px-2 py-1 font-mono text-[11px] text-slate-600 dark:bg-slate-800 dark:text-slate-300">ID: @Model.DisplayedMessage.Properties.MessageId</span>
                        }
                    </div>

                    <div class="p-4 lg:p-6">
                        @if (Model.DisplayedMessage is not null) {
                            <div class="grid gap-4 border-b border-dashed border-slate-200 pb-4 dark:border-slate-800 lg:grid-cols-2 xl:grid-cols-4">
                                <div>
                                    <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Enqueued Time</div>
                                    <div class="mt-1 font-mono text-xs text-slate-700 dark:text-slate-200">@Model.DisplayedMessage.Properties.EnqueuedTimeUtc.ToLocalTime()</div>
                                </div>
                                <div>
                                    <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Session ID</div>
                                    <div class="mt-1 font-mono text-xs text-slate-700 dark:text-slate-200">@(string.IsNullOrWhiteSpace(Model.DisplayedMessage.Properties.SessionId) ? "n/a" : Model.DisplayedMessage.Properties.SessionId)</div>
                                </div>
                                <div>
                                    <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Correlation ID</div>
                                    <div class="mt-1 font-mono text-xs text-slate-700 dark:text-slate-200">@(string.IsNullOrWhiteSpace(Model.DisplayedMessage.Properties.CorrelationId) ? "n/a" : Model.DisplayedMessage.Properties.CorrelationId)</div>
                                </div>
                                <div>
                                    <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Content Type</div>
                                    <div class="mt-1 text-xs text-slate-700 dark:text-slate-200">@(string.IsNullOrWhiteSpace(Model.DisplayedMessage.Properties.ContentType) ? "not set" : Model.DisplayedMessage.Properties.ContentType)</div>
                                </div>
                            </div>

                            <div class="mt-4 grid gap-6 xl:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
                                <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800">
                                    <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-800">
                                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                            <tr><th class="w-40 bg-slate-50 px-4 py-3 text-left font-medium text-slate-500 dark:bg-slate-950/40 dark:text-slate-400">Message ID</th><td class="px-4 py-3 font-mono text-xs text-slate-700 dark:text-slate-200">@Model.DisplayedMessage.Properties.MessageId</td></tr>
                                            <tr><th class="bg-slate-50 px-4 py-3 text-left font-medium text-slate-500 dark:bg-slate-950/40 dark:text-slate-400">Content Type</th><td class="px-4 py-3 text-slate-700 dark:text-slate-200">@(string.IsNullOrWhiteSpace(Model.DisplayedMessage.Properties.ContentType) ? "not set" : Model.DisplayedMessage.Properties.ContentType)</td></tr>
                                            <tr><th class="bg-slate-50 px-4 py-3 text-left font-medium text-slate-500 dark:bg-slate-950/40 dark:text-slate-400">Partition Key</th><td class="px-4 py-3 text-slate-700 dark:text-slate-200">@(string.IsNullOrWhiteSpace(Model.DisplayedMessage.Properties.PartitionKey) ? "n/a" : Model.DisplayedMessage.Properties.PartitionKey)</td></tr>
                                            <tr><th class="bg-slate-50 px-4 py-3 text-left font-medium text-slate-500 dark:bg-slate-950/40 dark:text-slate-400">Scheduled Enqueue</th><td class="px-4 py-3 font-mono text-xs text-slate-700 dark:text-slate-200">@(Model.DisplayedMessage.Properties.ScheduledEnqueueTime?.ToLocalTime().ToString() ?? "n/a")</td></tr>
                                            <tr><th class="bg-slate-50 px-4 py-3 text-left font-medium text-slate-500 dark:bg-slate-950/40 dark:text-slate-400">Time To Live</th><td class="px-4 py-3 font-mono text-xs text-slate-700 dark:text-slate-200">@(Model.DisplayedMessage.Properties.TimeToLive?.ToString() ?? "n/a")</td></tr>
                                        </tbody>
                                    </table>
                                </div>

                                <div>
                                    @if (Model.DisplayedMessage.ApplicationProperties?.Any() == true) {
                                        <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800">
                                            <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-800">
                                                <thead class="bg-slate-50 text-slate-500 dark:bg-slate-950/40 dark:text-slate-400">
                                                    <tr>
                                                        <th class="px-4 py-2 text-left font-medium">Application Property</th>
                                                        <th class="px-4 py-2 text-left font-medium">Value</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                                    @foreach (var prop in Model.DisplayedMessage.ApplicationProperties) {
                                                        <tr>
                                                            <td class="px-4 py-2 font-mono text-xs text-slate-700 dark:text-slate-200">@prop.Key</td>
                                                            <td class="px-4 py-2 text-xs text-slate-600 dark:text-slate-300">@prop.Value</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else {
                                        <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-950/50 dark:text-slate-400">
                                            No application properties on this message.
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="js-message-container mt-6">
                                <div class="mb-2 flex items-center justify-between">
                                    <h3 class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Message Body</h3>
                                    <button type="button" class="js-json-toggle inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-700 dark:hover:bg-slate-800" aria-pressed="false">Raw</button>
                                </div>
                                <pre class="js-message-body custom-scrollbar overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 p-4 font-mono text-xs leading-6 text-slate-700 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-200">@Model.DisplayedMessage.Body</pre>
                            </div>
                        }
                        else {
                            <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-950/50 dark:text-slate-400">
                                Use <span class="font-medium text-slate-700 dark:text-slate-200">Receive</span> to lock and inspect the next available message.
                            </div>
                        }
                    </div>
                </section>

                <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm shadow-slate-200/40 dark:border-slate-800 dark:bg-slate-900 dark:shadow-black/20">
                    <div class="flex flex-col gap-3 border-b border-slate-200 px-4 py-3 dark:border-slate-800 md:flex-row md:items-center md:justify-between">
                        <div class="flex items-center gap-2">
                            <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Peeked Messages</h2>
                            <span class="rounded-xl bg-slate-100 px-2 py-1 text-[11px] text-slate-500 dark:bg-slate-800 dark:text-slate-400">@peekedMessageSummary</span>
                        </div>
                    </div>

                    @if (Model.Messages.Count == 0) {
                        <div class="p-6">
                            <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-950/50 dark:text-slate-400">
                                No messages found.
                            </div>
                        </div>
                    }
                    else {
                        <div class="overflow-x-auto">
                            <table class="min-w-full text-left text-sm">
                                <thead class="border-b border-slate-200 bg-slate-50 text-slate-500 dark:border-slate-800 dark:bg-slate-950/40 dark:text-slate-400">
                                    <tr>
                                        <th class="px-4 py-3 font-medium">Message ID</th>
                                        <th class="px-4 py-3 font-medium">Enqueued Time</th>
                                        <th class="px-4 py-3 font-medium">Content Type</th>
                                        <th class="px-4 py-3 font-medium">Session / TTL</th>
                                        <th class="px-4 py-3 text-right font-medium">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                    @foreach (var message in Model.Messages) {
                                        <tr class="align-top transition hover:bg-slate-50 dark:hover:bg-slate-950/40">
                                            <td class="px-4 py-3">
                                                <div class="font-mono text-xs text-slate-700 dark:text-slate-200">@message.Properties.MessageId</div>
                                                @if (Model.RequiresSession && !string.IsNullOrWhiteSpace(message.Properties.SessionId)) {
                                                    <div class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">Session: @message.Properties.SessionId</div>
                                                }
                                            </td>
                                            <td class="px-4 py-3 text-xs text-slate-600 dark:text-slate-300">@message.Properties.EnqueuedTimeUtc.ToLocalTime().ToString("g")</td>
                                            <td class="px-4 py-3 text-xs text-slate-600 dark:text-slate-300">@(string.IsNullOrWhiteSpace(message.Properties.ContentType) ? "not set" : message.Properties.ContentType)</td>
                                            <td class="px-4 py-3 text-xs text-slate-600 dark:text-slate-300">
                                                @(string.IsNullOrWhiteSpace(message.Properties.SessionId) ? "No session" : message.Properties.SessionId)
                                                <div class="mt-1 text-[11px] text-slate-400 dark:text-slate-500">TTL: @(message.Properties.TimeToLive?.ToString() ?? "n/a")</div>
                                            </td>
                                            <td class="px-4 py-3 text-right">
                                                <button type="button" class="js-toggle-message inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-brand-700 transition hover:border-brand-200 hover:bg-brand-50 dark:border-slate-800 dark:bg-slate-900 dark:text-brand-300 dark:hover:border-brand-900/60 dark:hover:bg-brand-950/30" data-message-id="@message.Properties.MessageId">
                                                    <span class="js-expand-text">Expand</span>
                                                    <span class="js-collapse-text hidden">Collapse</span>
                                                </button>
                                            </td>
                                        </tr>
                                        <tr class="js-message-details hidden bg-slate-50/70 dark:bg-slate-950/50" data-message-id="@message.Properties.MessageId">
                                            <td colspan="5" class="px-4 py-4">
                                                <div class="grid gap-6 xl:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
                                                    <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800">
                                                        <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-800">
                                                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                                                <tr><th class="w-40 bg-white px-4 py-3 text-left font-medium text-slate-500 dark:bg-slate-900 dark:text-slate-400">Message ID</th><td class="px-4 py-3 font-mono text-xs text-slate-700 dark:text-slate-200">@message.Properties.MessageId</td></tr>
                                                                <tr><th class="bg-white px-4 py-3 text-left font-medium text-slate-500 dark:bg-slate-900 dark:text-slate-400">Enqueued Time</th><td class="px-4 py-3 font-mono text-xs text-slate-700 dark:text-slate-200">@message.Properties.EnqueuedTimeUtc.ToLocalTime()</td></tr>
                                                                <tr><th class="bg-white px-4 py-3 text-left font-medium text-slate-500 dark:bg-slate-900 dark:text-slate-400">Content Type</th><td class="px-4 py-3 text-slate-700 dark:text-slate-200">@(string.IsNullOrWhiteSpace(message.Properties.ContentType) ? "not set" : message.Properties.ContentType)</td></tr>
                                                                <tr><th class="bg-white px-4 py-3 text-left font-medium text-slate-500 dark:bg-slate-900 dark:text-slate-400">Partition Key</th><td class="px-4 py-3 text-slate-700 dark:text-slate-200">@(string.IsNullOrWhiteSpace(message.Properties.PartitionKey) ? "n/a" : message.Properties.PartitionKey)</td></tr>
                                                                <tr><th class="bg-white px-4 py-3 text-left font-medium text-slate-500 dark:bg-slate-900 dark:text-slate-400">Correlation ID</th><td class="px-4 py-3 text-slate-700 dark:text-slate-200">@(string.IsNullOrWhiteSpace(message.Properties.CorrelationId) ? "n/a" : message.Properties.CorrelationId)</td></tr>
                                                                <tr><th class="bg-white px-4 py-3 text-left font-medium text-slate-500 dark:bg-slate-900 dark:text-slate-400">Scheduled Enqueue</th><td class="px-4 py-3 font-mono text-xs text-slate-700 dark:text-slate-200">@(message.Properties.ScheduledEnqueueTime?.ToLocalTime().ToString() ?? "n/a")</td></tr>
                                                                <tr><th class="bg-white px-4 py-3 text-left font-medium text-slate-500 dark:bg-slate-900 dark:text-slate-400">Time To Live</th><td class="px-4 py-3 font-mono text-xs text-slate-700 dark:text-slate-200">@(message.Properties.TimeToLive?.ToString() ?? "n/a")</td></tr>
                                                            </tbody>
                                                        </table>
                                                    </div>

                                                    <div>
                                                        @if (message.ApplicationProperties?.Any() == true) {
                                                            <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800">
                                                                <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-800">
                                                                    <thead class="bg-white text-slate-500 dark:bg-slate-900 dark:text-slate-400">
                                                                        <tr>
                                                                            <th class="px-4 py-2 text-left font-medium">Application Property</th>
                                                                            <th class="px-4 py-2 text-left font-medium">Value</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                                                        @foreach (var prop in message.ApplicationProperties) {
                                                                            <tr>
                                                                                <td class="px-4 py-2 font-mono text-xs text-slate-700 dark:text-slate-200">@prop.Key</td>
                                                                                <td class="px-4 py-2 text-xs text-slate-600 dark:text-slate-300">@prop.Value</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        }
                                                        else {
                                                            <div class="rounded-xl border border-dashed border-slate-300 bg-white px-4 py-6 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
                                                                No application properties on this message.
                                                            </div>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="js-message-container mt-4">
                                                    <div class="mb-2 flex items-center justify-between">
                                                        <h3 class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Message Body</h3>
                                                        <button type="button" class="js-json-toggle inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-700 dark:hover:bg-slate-800" aria-pressed="false">Raw</button>
                                                    </div>
                                                    <pre class="js-message-body custom-scrollbar overflow-x-auto rounded-xl border border-slate-200 bg-white p-4 font-mono text-xs leading-6 text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200">@message.Body</pre>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            </div>
        </main>
    </div>

</div>

@section Scripts {
    <script>
        function addProperty() {
            const container = document.getElementById('properties-container');
            if (!(container instanceof HTMLElement))
                return;

            const index = container.querySelectorAll('.js-property-row').length;
            const group = document.createElement('div');

            group.className = 'js-property-row grid gap-3 rounded-2xl border border-slate-200 bg-slate-50/80 p-3 dark:border-slate-800 dark:bg-slate-950/60 xl:grid-cols-[minmax(0,1fr)_11rem_minmax(0,1fr)_auto]';
            group.innerHTML = `
                <input type="text" name="SendMessageApplicationProperties[${index}].Key" data-property-field="key" class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm shadow-slate-200/40 transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100 dark:shadow-black/20 dark:focus:border-brand-400" placeholder="Key" />
                <select name="SendMessageApplicationProperties[${index}].Type" data-property-field="type" class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm shadow-slate-200/40 transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100 dark:shadow-black/20 dark:focus:border-brand-400">
                    <option value="String" selected>String</option>
                    <option value="Bool">Bool</option>
                    <option value="Byte">Byte</option>
                    <option value="SByte">SByte</option>
                    <option value="Short">Short</option>
                    <option value="UShort">UShort</option>
                    <option value="Int">Int</option>
                    <option value="UInt">UInt</option>
                    <option value="Long">Long</option>
                    <option value="ULong">ULong</option>
                    <option value="Float">Float</option>
                    <option value="Double">Double</option>
                    <option value="Decimal">Decimal</option>
                    <option value="Char">Char</option>
                    <option value="Guid">Guid</option>
                    <option value="DateTime">DateTime</option>
                    <option value="DateTimeOffset">DateTimeOffset</option>
                    <option value="TimeSpan">TimeSpan</option>
                </select>
                <input type="text" name="SendMessageApplicationProperties[${index}].Value" data-property-field="value" class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm shadow-slate-200/40 transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100 dark:shadow-black/20 dark:focus:border-brand-400" placeholder="Value" />
                <button type="button" data-remove-property class="inline-flex items-center justify-center rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-medium text-rose-700 transition hover:bg-rose-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 dark:border-rose-900/70 dark:bg-rose-950/40 dark:text-rose-300 dark:hover:bg-rose-950/70">Remove</button>`;
            container.appendChild(group);
        }

        document.addEventListener('DOMContentLoaded', function () {
            function disableButtonOnValidSubmit(formId, submitButtonId, relatedInputIds) {
                const form = document.getElementById(formId);
                if (!(form instanceof HTMLFormElement))
                    return;

                form.addEventListener('submit', function () {
                    if (typeof form.checkValidity === 'function' && !form.checkValidity())
                        return;

                    const button = document.getElementById(submitButtonId);
                    if (button instanceof HTMLButtonElement)
                        button.disabled = true;

                    if (Array.isArray(relatedInputIds)) {
                        relatedInputIds.forEach(id => {
                            const input = document.getElementById(id);
                            if (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement || input instanceof HTMLSelectElement) {
                                input.readOnly = 'readOnly' in input ? true : input.readOnly;
                                input.setAttribute('aria-disabled', 'true');
                            }
                        });
                    }
                });
            }

            disableButtonOnValidSubmit('sendMessageForm', 'sendMessageSubmitBtn');
            disableButtonOnValidSubmit('refreshForm', 'refreshSubmitBtn');
            disableButtonOnValidSubmit('receiveForm', 'receiveSubmitBtn', ['receiveSessionIdInput']);
            disableButtonOnValidSubmit('disconnectForm', 'disconnectSubmitBtn');

            function initializeContentTypePicker() {
                const input = document.getElementById('contentTypeInput');
                const toggle = document.getElementById('contentTypePickerToggle');
                const menu = document.getElementById('contentTypePickerMenu');
                const emptyState = document.getElementById('contentTypePickerEmpty');

                if (!(input instanceof HTMLInputElement) ||
                    !(toggle instanceof HTMLButtonElement) ||
                    !(menu instanceof HTMLElement) ||
                    !(emptyState instanceof HTMLElement)) {
                    return;
                }

                const options = Array.from(menu.querySelectorAll('[data-content-type-option]'));
                let suppressFocusOpen = false;
                let filterTimerId = 0;

                function updateOptionVisibility(query) {
                    let visibleCount = 0;

                    options.forEach(option => {
                        if (!(option instanceof HTMLButtonElement))
                            return;

                        const value = option.dataset.contentTypeOption ?? '';
                        const isVisible = query.length === 0 || value.toLowerCase().includes(query);
                        option.classList.toggle('hidden', !isVisible);
                        if (isVisible)
                            visibleCount++;
                    });

                    emptyState.classList.toggle('hidden', visibleCount !== 0);
                }

                function showAllOptions() {
                    updateOptionVisibility('');
                }

                function filterOptions() {
                    updateOptionVisibility(input.value.trim().toLowerCase());
                }

                function scheduleFiltering() {
                    window.clearTimeout(filterTimerId);
                    filterTimerId = window.setTimeout(function () {
                        filterOptions();
                    }, 250);
                }

                function openMenu() {
                    window.clearTimeout(filterTimerId);
                    showAllOptions();
                    menu.classList.remove('hidden');
                    toggle.setAttribute('aria-expanded', 'true');
                }

                function closeMenu() {
                    window.clearTimeout(filterTimerId);
                    menu.classList.add('hidden');
                    toggle.setAttribute('aria-expanded', 'false');
                }

                input.addEventListener('input', function () {
                    openMenu();
                    scheduleFiltering();
                });

                toggle.addEventListener('click', function () {
                    if (menu.classList.contains('hidden')) {
                        openMenu();
                        input.focus();
                    }
                    else {
                        closeMenu();
                    }
                });

                options.forEach(option => {
                    if (!(option instanceof HTMLButtonElement))
                        return;

                    option.addEventListener('click', function () {
                        input.value = this.dataset.contentTypeOption ?? '';
                        suppressFocusOpen = true;
                        closeMenu();
                        input.focus();
                        window.setTimeout(function () {
                            suppressFocusOpen = false;
                        }, 0);
                    });
                });

                document.addEventListener('click', function (event) {
                    const target = event.target;
                    if (!(target instanceof Node))
                        return;

                    if (target !== input && !menu.contains(target) && !toggle.contains(target))
                        closeMenu();
                });

                input.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape')
                        closeMenu();
                });

                input.addEventListener('focus', function () {
                    if (suppressFocusOpen)
                        return;

                    openMenu();
                });
            }

            initializeContentTypePicker();

            function renumberApplicationProperties() {
                const container = document.getElementById('properties-container');
                if (!(container instanceof HTMLElement))
                    return;

                const groups = Array.from(container.querySelectorAll('.js-property-row'));
                for (let i = 0; i < groups.length; i++) {
                    const keyInput = groups[i].querySelector('[data-property-field="key"]');
                    const typeSelect = groups[i].querySelector('[data-property-field="type"]');
                    const valueInput = groups[i].querySelector('[data-property-field="value"]');

                    if (keyInput instanceof HTMLInputElement)
                        keyInput.name = `SendMessageApplicationProperties[${i}].Key`;

                    if (typeSelect instanceof HTMLSelectElement)
                        typeSelect.name = `SendMessageApplicationProperties[${i}].Type`;

                    if (valueInput instanceof HTMLInputElement)
                        valueInput.name = `SendMessageApplicationProperties[${i}].Value`;
                }
            }

            const sendFormWrapper = document.getElementById('sendFormWrapper');
            const toggleButton = document.getElementById('toggleSendFormBtn');
            const toggleButtonText = document.getElementById('toggleSendFormBtnText');
            const toggleButtonIcon = document.getElementById('toggleSendFormBtnIcon');

            if (sendFormWrapper instanceof HTMLElement && toggleButton instanceof HTMLButtonElement && toggleButtonText instanceof HTMLElement && toggleButtonIcon instanceof HTMLElement) {
                const storageKey = 'sendFormOpen';
                const stored = localStorage.getItem(storageKey);
                let isOpen = stored === null ? true : stored === 'true';

                function updateFormVisibility() {
                    sendFormWrapper.classList.toggle('js-send-form-hidden', !isOpen);
                    toggleButtonText.textContent = isOpen ? 'Hide' : 'Show';
                    toggleButtonIcon.textContent = isOpen ? 'keyboard_arrow_up' : 'keyboard_arrow_down';
                }

                updateFormVisibility();

                toggleButton.addEventListener('click', function () {
                    isOpen = !isOpen;
                    localStorage.setItem(storageKey, isOpen);
                    updateFormVisibility();
                });
            }

            document.querySelectorAll('.js-toggle-message').forEach(button => {
                button.addEventListener('click', function () {
                    if (!(this instanceof HTMLButtonElement))
                        return;

                    const messageId = this.getAttribute('data-message-id');
                    if (!messageId)
                        return;

                    const detailsRow = document.querySelector(`.js-message-details[data-message-id="${CSS.escape(messageId)}"]`);
                    const expandText = this.querySelector('.js-expand-text');
                    const collapseText = this.querySelector('.js-collapse-text');
                    if (!(detailsRow instanceof HTMLElement))
                        return;

                    const isHidden = detailsRow.classList.contains('hidden');
                    detailsRow.classList.toggle('hidden', !isHidden);

                    if (expandText instanceof HTMLElement)
                        expandText.classList.toggle('hidden', isHidden);

                    if (collapseText instanceof HTMLElement)
                        collapseText.classList.toggle('hidden', !isHidden);
                });
            });

            function escapeHtml(value) {
                return value
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');
            }

            function syntaxHighlightJson(jsonText) {
                return jsonText.replace(
                    /("(\\u[a-fA-F0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g,
                    function (match) {
                        let cssClass = 'json-number';

                        if (match.startsWith('"'))
                            cssClass = match.endsWith(':') ? 'json-key' : 'json-string';
                        else if (match === 'true' || match === 'false')
                            cssClass = 'json-boolean';
                        else if (match === 'null')
                            cssClass = 'json-null';

                        return `<span class="${cssClass}">${match}</span>`;
                    });
            }

            function getAssociatedBody(toggleButton) {
                return toggleButton.closest('.js-message-container')?.querySelector('.js-message-body') ?? null;
            }

            function tryFormatJsonBody(preElement) {
                if (!(preElement instanceof HTMLElement))
                    return;

                const rawText = preElement.textContent;
                if (!rawText)
                    return;

                const trimmed = rawText.trim();
                if (!trimmed)
                    return;

                try {
                    const parsed = JSON.parse(trimmed);
                    const formatted = JSON.stringify(parsed, null, 2);
                    const escaped = escapeHtml(formatted);

                    preElement.dataset.raw = rawText;
                    preElement.dataset.formatted = formatted;
                    preElement.dataset.jsonState = 'formatted';
                    preElement.innerHTML = syntaxHighlightJson(escaped);

                    const toggleButton = preElement.closest('.js-message-container')?.querySelector('.js-json-toggle');
                    if (toggleButton instanceof HTMLButtonElement) {
                        toggleButton.classList.add('js-json-toggle-visible');
                        toggleButton.textContent = 'Raw';
                        toggleButton.setAttribute('aria-pressed', 'true');
                    }
                }
                catch {
                }
            }

            document.querySelectorAll('.js-message-body').forEach(tryFormatJsonBody);

            document.querySelectorAll('.js-json-toggle').forEach(button => {
                button.addEventListener('click', function () {
                    if (!(this instanceof HTMLButtonElement))
                        return;

                    const preElement = getAssociatedBody(this);
                    if (!(preElement instanceof HTMLElement))
                        return;

                    const raw = preElement.dataset.raw;
                    const formatted = preElement.dataset.formatted;
                    if (!raw || !formatted)
                        return;

                    const isFormatted = preElement.dataset.jsonState !== 'raw';
                    if (isFormatted) {
                        preElement.textContent = raw;
                        preElement.dataset.jsonState = 'raw';
                        this.textContent = 'Formatted';
                        this.setAttribute('aria-pressed', 'false');
                    }
                    else {
                        const escaped = escapeHtml(formatted);
                        preElement.innerHTML = syntaxHighlightJson(escaped);
                        preElement.dataset.jsonState = 'formatted';
                        this.textContent = 'Raw';
                        this.setAttribute('aria-pressed', 'true');
                    }
                });
            });

            const propertiesContainer = document.getElementById('properties-container');
            if (propertiesContainer instanceof HTMLElement) {
                propertiesContainer.addEventListener('click', function (event) {
                    const target = event.target;
                    if (!(target instanceof HTMLElement) || !target.matches('[data-remove-property]'))
                        return;

                    const group = target.closest('.js-property-row');
                    if (!(group instanceof HTMLElement))
                        return;

                    group.remove();
                    renumberApplicationProperties();
                });
            }
        });
    </script>
}
