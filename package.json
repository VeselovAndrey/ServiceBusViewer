    "@tailwindcss/cli": "^4.1.13",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "material-design-icons-iconfont": "^6.7.0",
    "tailwindcss": "^4.3.3"
  }
}
